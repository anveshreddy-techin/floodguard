# FloodGuard AI — Environment Configuration
# Copy to .env and configure. NEVER commit .env with real secrets.

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=FloodGuard AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# ─── Security (REQUIRED — generate with: openssl rand -hex 32) ─────────────────
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32_MINIMUM_32_CHARS

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://floodguard:floodguard@localhost:5432/floodguard

# ─── Data Mode ────────────────────────────────────────────────────────────────
# DEMO mode: uses deterministic synthetic data, clearly labeled
# LIVE mode: requires external provider credentials below
DEFAULT_DATA_MODE=DEMO
DEMO_MODE=true

# ─── External Providers (all optional — system degrades gracefully) ─────────────
# Weather: open_meteo (no key needed for basic), imd (requires agreement), disabled
WEATHER_PROVIDER=open_meteo
WEATHER_API_KEY=

# Rainfall: demo (synthetic), imd (requires agreement + key), disabled
RAINFALL_PROVIDER=demo
RAINFALL_API_KEY=

# River: demo (synthetic), cwc (requires registration + key), disabled
RIVER_PROVIDER=demo
RIVER_API_KEY=

# Satellite: disabled, bhuvan (requires ISRO/NRSC registration), nasa
SATELLITE_PROVIDER=disabled
SATELLITE_API_KEY=

# ─── IoT / MQTT (optional) ────────────────────────────────────────────────────
# Leave blank for demo mode (uses built-in simulator)
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
IOT_ENABLED=false

# ─── Notifications (optional) ─────────────────────────────────────────────────
SMS_PROVIDER=disabled
SMS_API_KEY=
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=

# ─── AI Copilot (optional) ────────────────────────────────────────────────────
# Disabled: shows honest "Copilot unavailable" state
# gemini: requires Google AI Studio key
# openai: requires OpenAI key
COPILOT_PROVIDER=disabled
COPILOT_API_KEY=

# ─── Map ──────────────────────────────────────────────────────────────────────
MAP_PROVIDER=openstreetmap
MAP_PROVIDER_API_KEY=

# ─── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
INGEST_INTERVAL_MINUTES=15

# ─── Upload ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=data/uploads

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_DEMO_MODE=true
